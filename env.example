# Copy to .env — same as `.env.example` (kept for backwards compatibility).

PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/language_school
# DATABASE_URL=mongodb://localhost:27017/language_school

JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1h

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080
API_URL=http://localhost:5000

BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
AUTH_RATE_LIMIT_MAX=50
AUTH_REFRESH_RATE_LIMIT_MAX=300

APP_VERSION=1.0.0

# LiveKit Cloud (required for live classroom)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=
