# Copy to .env and adjust values.
# MongoDB connection (either variable works; the app reads MONGODB_URI first, then DATABASE_URL)
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/language_school
# DATABASE_URL=mongodb://localhost:27017/language_school

# JWT (access token; optional refresh stored hashed on user)
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1h

# Email (optional in dev — verification / password emails log or skip if unset)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080
API_URL=http://localhost:5000

BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=30

APP_VERSION=1.0.0

# Optional: Jitsi self-hosted domain (frontend may use VITE_JITSI_DOMAIN instead)
# JITSI_DOMAIN=meet.yourdomain.com
