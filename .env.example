# Copy to .env and adjust values.
# MongoDB connection (either variable works; the app reads MONGODB_URI first, then DATABASE_URL)
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/language_school
# DATABASE_URL=mongodb://localhost:27017/language_school

# JWT (access token; optional refresh stored hashed on user)
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1h

# Email (optional in dev — verification / password emails log or skip if unset)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080
API_URL=http://localhost:5000
# Production (Render dashboard):
# APP_URL=https://nouracademy.netlify.app
# FRONTEND_URL=https://nouracademy.netlify.app
# API_URL=https://backenda7na-1.onrender.com

BCRYPT_ROUNDS=12
# Rate limiting — 1000 req / 15 min per user (Bearer) or IP; disabled in development/test
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
AUTH_RATE_LIMIT_MAX=50
AUTH_REFRESH_RATE_LIMIT_MAX=300
# RATE_LIMIT_DISABLED=true
# TRUST_PROXY=true

APP_VERSION=1.0.0

# LiveKit Cloud (required for live classroom)
# Dashboard: https://cloud.livekit.io → Project Settings
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# WebSocket URL, e.g. wss://your-project.livekit.cloud
LIVEKIT_URL=
# Webhook URL to set in LiveKit Cloud: {API_URL}/api/webhooks/livekit

# Object storage for LiveKit Egress recordings (S3 or Cloudflare R2)
# Required together with LIVEKIT_* for automatic session recording
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=auto
# R2 example: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=true
# Optional public CDN/base URL; if set, playback uses this instead of presigned URLs
# S3_PUBLIC_BASE_URL=https://recordings.example.com
